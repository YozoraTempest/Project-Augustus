  {
    "id": "scopes.later",
    "scope": "Country",
    "immediate": [
      {
        "If": {
          "condition": {
            "All": [
              {
                "InScope": {
                  "selector": {
                    "Global": "place"
                  },
                  "kind": "Province",
                  "condition": {
                    "All": [
                      {
                        "GeographicMember": {
                          "target": "Current",
                          "level": "area",
                          "name": "other_area"
                        }
                      },
                      {
                        "With": {
                          "target": "Owner",
                          "kind": "Country",
                          "condition": {
                            "All": [
                              {
                                "EntityNamed": {
                                  "target": "Current",
                                  "name": "BBB"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "then": [
            {
              "Emit": "changed"
            }
          ],
          "otherwise": [
            {
              "Emit": "wrong_target"
            }
          ]
        }
      }
    ],
    "options": [
      {
        "id": "0",
        "effects": [
          {
            "Emit": "done"
          }
        ]
      }
    ],
    "after": []
