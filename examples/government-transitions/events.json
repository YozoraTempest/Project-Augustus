                          "name": "legitimacy"
                        }
                      },
                      "then": [
                        {
                          "UpdateNumeric": {
                            "target": "Current",
                            "slot": {
                              "Government": "legitimacy"
                            },
                            "operation": "Add",
                            "value": -3000
                          }
                        }
                      ],
                      "otherwise": []
                    }
                  }
                ]
              }
            }
