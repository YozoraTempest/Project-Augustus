[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://../target/debug/augustus_godot.dll"
windows.release.x86_64 = "res://../target/release/augustus_godot.dll"
linux.debug.x86_64 = "res://../target/debug/libaugustus_godot.so"
linux.release.x86_64 = "res://../target/release/libaugustus_godot.so"
macos.debug = "res://../target/debug/libaugustus_godot.dylib"
macos.release = "res://../target/release/libaugustus_godot.dylib"
