config_version=5

[application]
config/name="Project Augustus"
run/main_scene="res://scenes/launcher/launcher.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
AppSettings="*res://autoload/app_settings.gd"
GameSession="*res://autoload/game_session.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=600
window/size/min_width=720
window/size/min_height=480
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.063, 1)
