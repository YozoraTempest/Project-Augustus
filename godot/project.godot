config_version=5

[application]
config/name="Project Augustus"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
AppSettings="*res://autoload/app_settings.gd"
GameSession="*res://autoload/game_session.gd"

[display]
window/size/viewport_width=1200
window/size/viewport_height=760
window/size/min_width=720
window/size/min_height=480
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.063, 1)
